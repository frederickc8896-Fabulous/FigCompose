# Stable source line endings on Windows, macOS and Linux.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Scientific input/provenance checksums must retain the original CSV bytes.
*.csv -text
*.png binary
*.pdf binary
